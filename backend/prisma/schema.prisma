// Lược đồ CSDL FocuSpace — khớp docs/DATABASE.md §3 và ERD (docs/analysis/FocuSpace_Diagrams.drawio, trang ERD).
// Ràng buộc CHECK không khai báo được trong Prisma: thêm bằng migration SQL (xem prisma/checks.sql).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name") @db.VarChar(40)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz

  refreshTokens RefreshToken[]
  roomState     RoomStateRow?
  usageSessions UsageSession[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model RoomStateRow {
  userId      String   @id @map("user_id") @db.Uuid
  schemaVer   Int      @map("schema_ver") @db.SmallInt
  data        Json
  revision    Int
  updatedFrom String   @map("updated_from") @db.VarChar(64)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("room_states")
}

model UsageSession {
  id                  String    @id @db.Uuid
  clientId            String    @map("client_id") @db.VarChar(64)
  userId              String?   @map("user_id") @db.Uuid
  startedAt           DateTime  @map("started_at") @db.Timestamptz
  endedAt             DateTime? @map("ended_at") @db.Timestamptz
  setupMs             Int?      @map("setup_ms")
  interactionCount    Int       @default(0) @map("interaction_count")
  visitedStudy        Boolean   @default(false) @map("visited_study")
  visitedBed          Boolean   @default(false) @map("visited_bed")
  visitedOut          Boolean   @default(false) @map("visited_out")
  sleepTimerSet       Boolean   @default(false) @map("sleep_timer_set")
  sleepTimerCompleted Boolean   @default(false) @map("sleep_timer_completed")

  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  pomodoros PomodoroSession[]
  errors    ClientError[]

  @@index([userId, startedAt])
  @@map("usage_sessions")
}

model PomodoroSession {
  id             String    @id @db.Uuid
  usageSessionId String    @map("usage_session_id") @db.Uuid
  mode           String    @db.VarChar(8)
  plannedSec     Int       @map("planned_sec")
  startedAt      DateTime  @map("started_at") @db.Timestamptz
  endedAt        DateTime? @map("ended_at") @db.Timestamptz
  outcome        String    @db.VarChar(12)

  usageSession UsageSession @relation(fields: [usageSessionId], references: [id], onDelete: Cascade)

  @@index([usageSessionId])
  @@map("pomodoro_sessions")
}

model ClientError {
  id             BigInt   @id @default(autoincrement())
  usageSessionId String   @map("usage_session_id") @db.Uuid
  kind           String   @db.VarChar(32)
  message        String?  @db.VarChar(500)
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz

  usageSession UsageSession @relation(fields: [usageSessionId], references: [id], onDelete: Cascade)

  @@unique([usageSessionId, kind, occurredAt])
  @@map("client_errors")
}

model ItemType {
  code        String  @id @db.VarChar(16)
  name        String  @db.VarChar(40)
  description String? @db.VarChar(80)
  itemGroup   String  @map("item_group") @db.VarChar(8)
  width       Int     @db.SmallInt
  height      Int     @db.SmallInt
  inStudy     Boolean @default(false) @map("in_study")
  inBed       Boolean @default(false) @map("in_bed")
  defaultVol  Float?  @map("default_vol") @db.Real
  removable   Boolean @default(true)
  sortOrder   Int     @unique @map("sort_order") @db.SmallInt

  @@map("item_types")
}

model Scene {
  code        String  @id @db.VarChar(16)
  name        String  @db.VarChar(40)
  description String  @db.VarChar(80)
  isDefault   Boolean @default(false) @map("is_default")
  sortOrder   Int     @unique @map("sort_order") @db.SmallInt

  @@map("scenes")
}
